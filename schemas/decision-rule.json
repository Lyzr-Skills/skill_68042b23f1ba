{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionRule",
  "type": "object",
  "properties": {
    "rule_id": { "type": "string" },
    "experiment_id": { "type": "string" },
    "if_metric": { "type": "string" },
    "operator": {
      "type": "string",
      "enum": [">", "<", ">=", "<=", "=="]
    },
    "value": { "type": "number" },
    "action": {
      "type": "string",
      "enum": ["scale", "pivot", "iterate", "continue", "kill"]
    },
    "details": { "type": "string" }
  },
  "required": ["rule_id", "if_metric", "operator", "value", "action"]
}
